NODE_ENV=development
PORT=3000

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Mínimo 32 caracteres aleatorios
JWT_SECRET=

# Orígenes del frontend permitidos, separados por comas
