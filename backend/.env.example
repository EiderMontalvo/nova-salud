IMAGE_SFTP_PORT=22
IMAGE_SFTP_USER=
IMAGE_SFTP_PASSWORD=
IMAGE_SFTP_DIRECTORY=
IMAGE_SFTP_HOST_SHA256=
IMAGE_PUBLIC_URL=

# Solo para npm run crear-admin; bórralos después de usarlo
ADMIN_NOMBRE=
ADMIN_CORREO=
ADMIN_PASSWORD=
